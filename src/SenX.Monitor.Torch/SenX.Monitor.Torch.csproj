<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The whole of Monitor for one Torch server: measuring, history, reports and the charts, in Torch's
    own window. It isn't in Monitor.slnx, so nothing here touches the Quasar or Linux builds. See docs/Torch.md.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>SenX.Monitor.Torch</AssemblyName>
    <RootNamespace>SenX.Monitor.Torch</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <TorchDir Condition="'$(TorchDir)' == ''">$(DS64)\..</TorchDir>

    <!-- The access attribute is defined in source, so the publicizer must not inject a second copy. -->
    <PublicizerRuntimeStrategies>Unsafe</PublicizerRuntimeStrategies>
  </PropertyGroup>

  <!-- All of these are already in Torch's folder, so none are copied. -->
  <ItemGroup>
    <Reference Include="Torch" HintPath="$(TorchDir)\Torch.dll" Private="False" />
    <Reference Include="Torch.API" HintPath="$(TorchDir)\Torch.API.dll" Private="False" />
    <Reference Include="Torch.Server" HintPath="$(TorchDir)\Torch.Server.exe" Private="False" />
    <Reference Include="Newtonsoft.Json" HintPath="$(TorchDir)\Newtonsoft.Json.dll" Private="False" />
    <Reference Include="NLog" HintPath="$(TorchDir)\NLog.dll" Private="False" />
    <Reference Include="System.Net.Http" />
    <Reference Include="Sandbox.Game" HintPath="$(DS64)\Sandbox.Game.dll" Private="False" />
    <Reference Include="Sandbox.Common" HintPath="$(DS64)\Sandbox.Common.dll" Private="False" />
    <Reference Include="VRage" HintPath="$(DS64)\VRage.dll" Private="False" />
    <Reference Include="VRage.Game" HintPath="$(DS64)\VRage.Game.dll" Private="False" />
    <Reference Include="VRage.Library" HintPath="$(DS64)\VRage.Library.dll" Private="False" />
    <Reference Include="VRage.Math" HintPath="$(DS64)\VRage.Math.dll" Private="False" />
    <Reference Include="HavokWrapper" HintPath="$(DS64)\HavokWrapper.dll" Private="False" />
    <Reference Include="Sandbox.Graphics" HintPath="$(DS64)\Sandbox.Graphics.dll" Private="False" />
  </ItemGroup>

  <!-- Build time only. This changes what the compiler can see, and ships nothing. -->
  <ItemGroup>
    <PackageReference Include="Krafs.Publicizer" Version="2.3.2" PrivateAssets="all" ExcludeAssets="contentFiles" />
    <Publicize Include="Sandbox.Game" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TorchPreview" />
    <InternalsVisibleTo Include="SenX.Monitor.Torch.Lock" />
    <!-- WPF projects leave these two out of the default imports, and the shared files expect them. -->
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
    <ProjectReference Include="..\SenX.Monitor.Core\SenX.Monitor.Core.csproj" />
    <ProjectReference Include="..\SenX.Monitor.Contracts\SenX.Monitor.Contracts.csproj" />
    <ProjectReference Include="..\SenX.Monitor.Api\SenX.Monitor.Api.csproj" />
  </ItemGroup>

  <!-- The same files Quasar's build uses. What net48 lacks is in Shims, so these stay as they are. -->
  <ItemGroup>
    <Compile Include="..\SenX.Monitor\Components\Charts\ChartTypes.cs" Link="Shared\ChartTypes.cs" />
    <Compile Include="..\SenX.Monitor\Services\BoardBuilder.cs" Link="Shared\BoardBuilder.cs" />
    <Compile Include="..\SenX.Monitor\Services\BoardPage.cs" Link="Shared\BoardPage.cs" />
    <Compile Include="..\SenX.Monitor\Services\BoardReads.cs" Link="Shared\BoardReads.cs" />
    <Compile Include="..\SenX.Monitor\Services\ChartBuilder.cs" Link="Shared\ChartBuilder.cs" />
    <Compile Include="..\SenX.Monitor\Services\ChartImage.cs" Link="Shared\ChartImage.cs" />
    <Compile Include="..\SenX.Monitor\Services\ChartImages.cs" Link="Shared\ChartImages.cs" />
    <Compile Include="..\SenX.Monitor\Services\ImageCanvas.cs" Link="Shared\ImageCanvas.cs" />
    <Compile Include="..\SenX.Monitor\Services\StrokeFont.cs" Link="Shared\StrokeFont.cs" />
    <Compile Include="..\SenX.Monitor\Services\HistoryStore.cs" Link="Shared\HistoryStore.cs" />
    <Compile Include="..\SenX.Monitor\Services\HistoryWindows.cs" Link="Shared\HistoryWindows.cs" />
    <Compile Include="..\SenX.Monitor\Services\IMonitorServers.cs" Link="Shared\IMonitorServers.cs" />
    <Compile Include="..\SenX.Monitor\Services\MonitorApi.cs" Link="Shared\MonitorApi.cs" />
    <Compile Include="..\SenX.Monitor\Services\MonitorBaselines.cs" Link="Shared\MonitorBaselines.cs" />
    <Compile Include="..\SenX.Monitor\Services\MonitorCollector.cs" Link="Shared\MonitorCollector.cs" />
    <Compile Include="..\SenX.Monitor\Services\MonitorIncidents.cs" Link="Shared\MonitorIncidents.cs" />
    <Compile Include="..\SenX.Monitor\Services\MonitorRuns.cs" Link="Shared\MonitorRuns.cs" />
    <Compile Include="..\SenX.Monitor\Services\MonitorSettings.cs" Link="Shared\MonitorSettings.cs" />
    <Compile Include="..\SenX.Monitor\Services\MonitorTools.cs" Link="Shared\MonitorTools.cs" />
    <Compile Include="..\SenX.Monitor\Services\MonitorWebhooks.cs" Link="Shared\MonitorWebhooks.cs" />
    <Compile Include="..\SenX.Monitor\Services\ReportText.cs" Link="Shared\ReportText.cs" />
    <Compile Include="..\SenX.Monitor\Services\StateFiles.cs" Link="Shared\StateFiles.cs" />
  </ItemGroup>

  <!-- The full board's page, the same files Quasar serves, built into the plugin for its small web server. -->
  <ItemGroup>
    <EmbeddedResource Include="..\SenX.Monitor\wwwroot\board.js" LogicalName="MonitorBoard/board.js" />
    <EmbeddedResource Include="..\SenX.Monitor\wwwroot\board.css" LogicalName="MonitorBoard/board.css" />
    <EmbeddedResource Include="..\SenX.Monitor\wwwroot\lib\uplot\uPlot.iife.min.js" LogicalName="MonitorBoard/lib/uplot/uPlot.iife.min.js" />
    <EmbeddedResource Include="..\SenX.Monitor\wwwroot\lib\uplot\uPlot.min.css" LogicalName="MonitorBoard/lib/uplot/uPlot.min.css" />
  </ItemGroup>

  <!--
    The worker, shared with Magnetar. What's left out is what that build does through Harmony and its SDK.
    Worker\ here holds Torch's versions of those, on Torch's own PatchManager, and no Harmony is involved.
  -->
  <ItemGroup>
    <Compile Include="..\SenX.Monitor.Magnetar\**\*.cs" Exclude="..\SenX.Monitor.Magnetar\obj\**;..\SenX.Monitor.Magnetar\bin\**;..\SenX.Monitor.Magnetar\**\*.Harmony.cs;..\SenX.Monitor.Magnetar\**\*.Magnetar.cs;..\SenX.Monitor.Magnetar\MonitorPlugin.cs;..\SenX.Monitor.Magnetar\QuasarBridge.cs;..\SenX.Monitor.Magnetar\MonitorCommands.cs;..\SenX.Monitor.Magnetar\MonitorLog.cs;..\SenX.Monitor.Magnetar\Hooks\PluginHooks.cs;..\SenX.Monitor.Magnetar\Patching\CallSiteRewriter.cs;..\SenX.Monitor.Magnetar\Patching\Fingerprints.Generated.cs" Link="Shared\Worker\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- What Torch loads: a zip of the manifest and every assembly, straight into its Plugins folder. -->
  <Target Name="PackTorchPlugin" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <PluginStage>$(MSBuildThisFileDirectory)..\..\artifacts\torch\stage\</PluginStage>
      <PluginZip>$(MSBuildThisFileDirectory)..\..\artifacts\torch\Monitor.zip</PluginZip>
    </PropertyGroup>
    <ItemGroup>
      <PluginFile Include="manifest.xml" />
      <PluginFile Include="$(OutDir)SenX.Monitor*.dll" />
      <PluginFile Include="$(OutDir)SenX.Monitor*.pdb" />
    </ItemGroup>
    <RemoveDir Directories="$(PluginStage)" />
    <Copy SourceFiles="@(PluginFile)" DestinationFolder="$(PluginStage)" />
    <ZipDirectory SourceDirectory="$(PluginStage)" DestinationFile="$(PluginZip)" Overwrite="true" />
  </Target>

  <Target Name="ValidateTorchReferences" BeforeTargets="ResolveAssemblyReferences" Condition="!Exists('$(TorchDir)\Torch.dll')">
    <Error Text="Torch was not found under TorchDir='$(TorchDir)'. Set TorchDir to the folder holding Torch.dll." />
  </Target>

</Project>
