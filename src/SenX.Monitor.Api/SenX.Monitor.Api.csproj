<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>SenX.Monitor.Api</AssemblyName>
    <RootNamespace>SenX.Monitor.Api</RootNamespace>

    <!--
      Stays at this while changes only add things, so a plugin built against a newer API still loads
      against an older Monitor. IMonitorApi.Version says what's really there.
    -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Version>1.0.0</Version>

  </PropertyGroup>

</Project>
