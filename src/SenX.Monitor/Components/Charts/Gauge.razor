@using System.Globalization

<figure class="monitor-chart monitor-gauge">
    <figcaption>@Title</figcaption>
    <svg viewBox="0 0 100 58" role="img" aria-label="@($"{Title}: {Value:0.00}")">
        <path class="monitor-gauge-track" d="M10 50 A40 40 0 0 1 90 50" pathLength="100" />
        <path class="monitor-gauge-value @Color" d="M10 50 A40 40 0 0 1 90 50" pathLength="100" stroke-dasharray="@Share 100" />
        <text x="50" y="48" text-anchor="middle">@Value.ToString("0.00", CultureInfo.InvariantCulture)</text>
    </svg>
</figure>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    [Parameter, EditorRequired] public double Value { get; set; }

    [Parameter] public double Maximum { get; set; } = 1d;

    private string Share => (Math.Clamp(Value / Maximum, 0d, 1d) * 100d).ToString("0.#", CultureInfo.InvariantCulture);

    private string Color => Value / Maximum >= 0.9d ? ChartColors.Good : Value / Maximum >= 0.6d ? ChartColors.Network : ChartColors.Bad;
}
