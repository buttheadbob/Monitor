<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <!-- Game DLLs and NuGet disagree on System.Buffers and friends. This tool loads assemblies through its own resolver, so it doesn't matter here. -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3276</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.4.2" />
  </ItemGroup>

  <!-- The command check talks to the SDK directly. Game DLLs still come from the folder on the command line. -->
  <ItemGroup>
    <Reference Include="PluginSdk" HintPath="$(MagnetarBin)/PluginSdk.dll" />
    <Reference Include="VRage.Game" HintPath="$(DS64)\VRage.Game.dll" Private="False" />
    <Reference Include="Sandbox.Game" HintPath="$(DS64)\Sandbox.Game.dll" Private="False" />
    <Reference Include="HavokWrapper" HintPath="$(DS64)\HavokWrapper.dll" Private="False" />
    <Reference Include="VRage.Math" HintPath="$(DS64)\VRage.Math.dll" Private="False" />
    <Reference Include="VRage.Library" HintPath="$(DS64)\VRage.Library.dll" Private="False" />
    <Reference Include="VRage" HintPath="$(DS64)\VRage.dll" Private="False" />
    <Reference Include="Newtonsoft.Json" HintPath="$(DS64)\Newtonsoft.Json.dll" Private="False" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SenX.Monitor.Magnetar\SenX.Monitor.Magnetar.csproj" />
    <ProjectReference Include="..\..\src\SenX.Monitor.Core\SenX.Monitor.Core.csproj" />
    <ProjectReference Include="..\..\src\SenX.Monitor.Contracts\SenX.Monitor.Contracts.csproj" />
  </ItemGroup>

</Project>
